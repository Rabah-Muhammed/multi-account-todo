# Auth0 Configuration
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_SECRET=                             # Run: openssl rand -hex 32
AUTH0_AUDIENCE=https://your-tenant.us.auth0.com/api/v2/
APP_BASE_URL=http://localhost:3000

# Django Backend
DJANGO_SECRET_KEY=dev-secret-key-change-in-prod
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Optional: PostgreSQL (defaults to SQLite if unset)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/todo_db